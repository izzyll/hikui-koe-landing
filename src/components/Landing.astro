---
import { Picture } from 'astro:assets';
import { dict, product, homePath, abs, withBase, type Lang, type Feature } from '../i18n/content';
import { DOWNLOAD_URL, REPO_URL } from '../config';
import liveEs from '../assets/screens/live-es.png';
import liveEn from '../assets/screens/live-en.png';
import contextEs from '../assets/screens/context-es.png';
import contextEn from '../assets/screens/context-en.png';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = dict[lang];
const other: Lang = lang === 'es' ? 'en' : 'es';
const site = Astro.site;
const canonical = abs(site, homePath[lang]);
const ogImage = abs(site, product.ogImage[lang]);
const shots = {
  es: { live: liveEs, context: contextEs },
  en: { live: liveEn, context: contextEn },
}[lang];
const year = new Date().getFullYear();

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: product.name,
    alternateName: product.nameJa,
    description: t.meta.description,
    url: canonical,
    image: ogImage,
    inLanguage: t.htmlLang,
    operatingSystem: product.operatingSystem,
    applicationCategory: t.appCategory,
    downloadUrl: DOWNLOAD_URL,
    softwareRequirements: t.requirements,
    isAccessibleForFree: true,
    sameAs: [REPO_URL],
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    inLanguage: t.htmlLang,
    mainEntity: t.faq.items.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];

const icons: Record<Feature['icon'], string> = {
  shield: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>',
  lock: '<rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>',
  eye: '<path d="M9.9 4.2A10 10 0 0 1 12 4c7 0 10 8 10 8a13 13 0 0 1-1.7 2.7"/><path d="M6.6 6.6A13.5 13.5 0 0 0 2 12s3 8 10 8a9.7 9.7 0 0 0 5.4-1.6"/><path d="M9.9 9.9a3 3 0 0 0 4.2 4.2"/><path d="m2 2 20 20"/>',
  spark: '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/><path d="M8 9h8M8 13h5"/>',
  globe: '<circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>',
  keys: '<rect x="2" y="5" width="20" height="14" rx="2"/><path d="M6 9h.01M10 9h.01M14 9h.01M18 9h.01M7 15h10"/>',
};
const dl = '<path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M5 21h14"/>';
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={abs(site, homePath.es)} />
    <link rel="alternate" hreflang="en" href={abs(site, homePath.en)} />
    <link rel="alternate" hreflang="x-default" href={abs(site, homePath.es)} />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <link rel="apple-touch-icon" href={withBase("/apple-touch-icon.png")} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <link rel="sitemap" href={withBase("/sitemap-index.xml")} />
    <link rel="alternate" type="text/plain" title="llms.txt" href={withBase("/llms.txt")} />
    <meta name="theme-color" content="#111217" />
    <meta name="color-scheme" content="dark" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={product.name} />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={t.ogLocale} />
    <meta property="og:locale:alternate" content={dict[other].ogLocale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.meta.title} />
    <meta name="twitter:description" content={t.meta.description} />
    <meta name="twitter:image" content={ogImage} />

    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="logo" href={withBase(homePath[lang])} aria-label={product.name}>
          <span class="dot" aria-hidden="true"></span>
          <span class="word">{product.name}</span>
          <span class="ja" lang="ja">{product.nameJa}</span>
        </a>
        <nav aria-label={t.nav.label} class="actions">
          <ul class="lang" aria-label={t.nav.langLabel}>
            <li>
              <a href={withBase(homePath.es)} hreflang="es" lang="es" aria-current={lang === 'es' ? 'page' : undefined}>ES</a>
            </li>
            <li>
              <a href={withBase(homePath.en)} hreflang="en" lang="en" aria-current={lang === 'en' ? 'page' : undefined}>EN</a>
            </li>
          </ul>
          <a class="btn btn-sm" href={DOWNLOAD_URL}>
            <svg viewBox="0 0 24 24" aria-hidden="true" set:html={dl} />
            {t.nav.download}
          </a>
        </nav>
      </div>
    </header>

    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="wrap hero-grid">
          <div class="hero-copy">
            <p class="eyebrow"><span class="dot sm" aria-hidden="true"></span>{t.hero.eyebrow}</p>
            <h1 id="hero-title">{t.hero.title}</h1>
            <p class="lead">{t.hero.subtitle}</p>
            <div class="ctas">
              <a class="btn btn-lg" href={DOWNLOAD_URL}>
                <svg viewBox="0 0 24 24" aria-hidden="true" set:html={dl} />
                {t.cta}
              </a>
              <a class="btn-ghost" href={REPO_URL}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.1-1.3-.3-2.5-1-3.5.3-1.2.3-2.4 0-3.5 0 0-1 0-3 1.5a10.6 10.6 0 0 0-6 0C7 2 6 2 6 2c-.3 1.1-.3 2.3 0 3.5A5.4 5.4 0 0 0 5 9c0 3.5 3 5.5 6 5.5-.4.5-.7 1-.8 1.6-.2.6-.3 1.2-.2 1.9v4"/><path d="M9 18c-4.5 2-5-2-7-2"/></svg>
                {t.secondary}
              </a>
            </div>
            <p class="note">{t.hero.note}</p>
          </div>
          <div class="hero-shot">
            <Picture
              src={shots.live}
              formats={['avif', 'webp']}
              widths={[460, 920]}
              sizes="(max-width: 540px) calc(100vw - 32px), 460px"
              width={460}
              height={640}
              alt={t.hero.shotAlt}
              loading="eager"
              fetchpriority="high"
              class="shot"
            />
          </div>
        </div>
      </section>

      <section class="how band" aria-labelledby="how-title">
        <div class="wrap how-grid">
          <div class="how-copy">
            <p class="kicker">{t.how.kicker}</p>
            <h2 id="how-title">{t.how.title}</h2>
            <ol class="steps">
              {
                t.how.steps.map((s, i) => (
                  <li>
                    <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                    <div>
                      <h3>{s.title}</h3>
                      <p>{s.body}</p>
                    </div>
                  </li>
                ))
              }
            </ol>
          </div>
          <div class="how-shot">
            <Picture
              src={shots.context}
              formats={['avif', 'webp']}
              widths={[400, 800]}
              sizes="(max-width: 480px) calc(100vw - 32px), 400px"
              width={400}
              height={557}
              alt={t.how.shotAlt}
              class="shot"
            />
          </div>
        </div>
      </section>

      <section class="features" aria-labelledby="features-title">
        <div class="wrap">
          <p class="kicker">{t.features.kicker}</p>
          <h2 id="features-title">{t.features.title}</h2>
          <ul class="feature-grid">
            {
              t.features.items.map((f) => (
                <li>
                  <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons[f.icon]} />
                  <h3>{f.title}</h3>
                  <p>{f.body}</p>
                  {f.icon === 'keys' && (
                    <dl class="keys">
                      {t.shortcuts.map((s) => (
                        <div>
                          <dt>
                            <kbd>{s.keys}</kbd>
                          </dt>
                          <dd>{s.action}</dd>
                        </div>
                      ))}
                    </dl>
                  )}
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section class="faq band" aria-labelledby="faq-title">
        <div class="wrap faq-grid">
          <div class="faq-head">
            <p class="kicker">{t.faq.kicker}</p>
            <h2 id="faq-title">{t.faq.title}</h2>
            <p class="name-note">{t.faq.nameNote}</p>
          </div>
          <div class="faq-list">
            {
              t.faq.items.map((f, i) => (
                <details open={i === 0}>
                  <summary>
                    <h3>{f.q}</h3>
                  </summary>
                  <p>{f.a}</p>
                </details>
              ))
            }
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="wrap foot">
        <span>© {year} {product.name}</span>
        <a href={REPO_URL}>{t.footer.github}</a>
        <a href={withBase(homePath[other])} hreflang={other} lang={other}>{t.footer.otherLang}</a>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #111217;
    --surface: #17181e;
    --surface-2: #23242c;
    --line: #2e3039;
    --text: #eceef4;
    --muted: #a2a6b5;
    --accent: #6c8cff;
    --accent-hover: #8aa3ff;
    --accent-ink: #0d1022;
    --ok: #3ddc97;
    --radius: 10px;
    --font: 'Inter', 'Segoe UI Variable Text', 'Segoe UI', system-ui, -apple-system, Roboto, sans-serif;
    color-scheme: dark;
  }
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html {
    -webkit-text-size-adjust: 100%;
    scroll-behavior: smooth;
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: var(--font);
    font-size: 16px;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
    overflow-wrap: anywhere;
  }
  h1,
  h2,
  h3,
  p {
    margin: 0;
  }
  a {
    color: inherit;
  }
  img {
    display: block;
    max-width: 100%;
    height: auto;
  }
  svg {
    width: 1em;
    height: 1em;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    flex: none;
  }
  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 4px;
  }
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
    *,
    *::before,
    *::after {
      transition: none !important;
      animation: none !important;
    }
  }
</style>

<style>
  .wrap {
    width: 100%;
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: 16px;
  }
  @media (min-width: 720px) {
    .wrap {
      padding-inline: 32px;
    }
  }
  .skip {
    position: absolute;
    left: -9999px;
  }
  .skip:focus {
    left: 16px;
    top: 12px;
    z-index: 10;
    background: var(--surface-2);
    padding: 8px 12px;
    border-radius: 8px;
  }

  /* Header */
  .site-header {
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px);
    position: sticky;
    top: 0;
    z-index: 5;
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 64px;
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    text-decoration: none;
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--ok);
    box-shadow: 0 0 10px color-mix(in srgb, var(--ok) 60%, transparent);
    display: inline-block;
  }
  .dot.sm {
    width: 7px;
    height: 7px;
  }
  .ja {
    font-weight: 400;
    font-size: 0.8rem;
    color: var(--muted);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .lang {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 3px;
    gap: 2px;
    border: 1px solid var(--line);
    border-radius: 8px;
  }
  .lang a {
    display: block;
    padding: 3px 9px;
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--muted);
    text-decoration: none;
  }
  .lang a[aria-current='page'] {
    background: var(--surface-2);
    color: var(--text);
  }
  .lang a:hover {
    color: var(--text);
  }

  /* Buttons */
  .btn,
  .btn-ghost {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    border-radius: var(--radius);
    font-weight: 600;
    text-decoration: none;
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease;
  }
  .btn {
    background: var(--accent);
    color: var(--accent-ink);
  }
  .btn:hover {
    background: var(--accent-hover);
  }
  .btn-sm {
    padding: 8px 14px;
    font-size: 0.875rem;
  }
  .btn-lg {
    padding: 14px 22px;
    font-size: 1rem;
  }
  .btn-ghost {
    padding: 13px 20px;
    border: 1px solid var(--line);
    font-weight: 500;
  }
  .btn-ghost:hover {
    border-color: #4a4d5a;
    background: var(--surface);
  }

  /* Hero */
  .hero {
    background: radial-gradient(60% 70% at 75% 45%, rgb(108 140 255 / 0.13), transparent 70%);
    padding-top: 48px;
    overflow: hidden;
  }
  .hero-grid {
    display: grid;
    gap: 40px;
  }
  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    align-self: flex-start;
    padding: 5px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.8rem;
  }
  h1 {
    font-size: clamp(2.1rem, 1.3rem + 3.4vw, 3.75rem);
    line-height: 1.06;
    letter-spacing: -0.03em;
    font-weight: 700;
    text-wrap: balance;
  }
  .lead {
    color: var(--muted);
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.2rem);
    max-width: 58ch;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .note {
    color: var(--muted);
    font-size: 0.82rem;
  }
  .hero-shot {
    display: flex;
    justify-content: center;
  }
  .shot {
    width: 100%;
    max-width: 460px;
    border-radius: 14px;
    border: 1px solid var(--line);
    box-shadow: 0 30px 80px rgb(0 0 0 / 0.55);
  }
  @media (max-width: 539px) {
    .ctas > a {
      width: 100%;
    }
  }
  @media (min-width: 960px) {
    .hero {
      padding-top: 88px;
    }
    .hero-grid {
      grid-template-columns: 1fr 460px;
      gap: 72px;
      align-items: end;
    }
    .hero-copy {
      padding-bottom: 88px;
      gap: 28px;
    }
    .hero-shot img,
    .shot {
      margin-bottom: -1px;
      border-bottom-left-radius: 0;
      border-bottom-right-radius: 0;
    }
  }
  @media (max-width: 959px) {
    .hero-shot {
      padding-bottom: 48px;
    }
  }

  /* Sections */
  .band {
    background: var(--surface);
    border-block: 1px solid var(--line);
  }
  .how,
  .features,
  .faq {
    padding-block: 72px;
  }
  @media (min-width: 960px) {
    .how,
    .features,
    .faq {
      padding-block: 112px;
    }
  }
  .kicker {
    color: var(--accent);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 12px;
  }
  h2 {
    font-size: clamp(1.75rem, 1.3rem + 1.8vw, 2.5rem);
    line-height: 1.12;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  h3 {
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  /* How */
  .how-grid {
    display: grid;
    gap: 48px;
  }
  .how-shot {
    display: flex;
    justify-content: center;
  }
  .how-shot .shot {
    max-width: 400px;
  }
  .steps {
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
  }
  .steps li {
    display: flex;
    gap: 20px;
    padding-block: 22px;
    border-bottom: 1px solid var(--line);
  }
  .steps li:last-child {
    border-bottom: 0;
  }
  .num {
    color: var(--accent);
    font-weight: 600;
    font-size: 0.95rem;
    padding-top: 2px;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    overflow-wrap: normal;
    min-width: 2ch;
  }
  .steps p {
    color: var(--muted);
    margin-top: 6px;
  }
  @media (min-width: 960px) {
    .how-grid {
      grid-template-columns: 400px 1fr;
      gap: 96px;
      align-items: center;
    }
    .how-shot {
      order: -1;
    }
  }

  /* Features */
  .feature-grid {
    list-style: none;
    margin: 48px 0 0;
    padding: 0;
    display: grid;
    gap: 36px 48px;
  }
  @media (min-width: 640px) {
    .feature-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1000px) {
    .feature-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .feature-grid li {
    border-top: 1px solid var(--line);
    padding-top: 22px;
  }
  .feature-grid li > svg {
    color: var(--accent);
    font-size: 22px;
    margin-bottom: 14px;
  }
  .feature-grid p {
    color: var(--muted);
    margin-top: 8px;
    font-size: 0.95rem;
  }
  .keys {
    margin: 10px 0 0;
    display: grid;
    gap: 6px;
    font-size: 0.9rem;
  }
  .keys div {
    display: flex;
    gap: 10px;
    align-items: baseline;
    flex-wrap: wrap;
  }
  .keys dd {
    margin: 0;
    color: var(--muted);
  }
  kbd {
    font-family: ui-monospace, 'Cascadia Mono', Consolas, monospace;
    font-size: 0.8rem;
    padding: 2px 7px;
    border: 1px solid var(--line);
    border-bottom-width: 2px;
    border-radius: 6px;
    background: var(--surface-2);
    color: var(--text);
    white-space: nowrap;
  }

  /* FAQ */
  .faq-grid {
    display: grid;
    gap: 32px;
  }
  .name-note {
    color: var(--muted);
    margin-top: 16px;
    max-width: 40ch;
  }
  @media (min-width: 960px) {
    .faq-grid {
      grid-template-columns: 380px 1fr;
      gap: 96px;
    }
  }
  details {
    border-bottom: 1px solid var(--line);
  }
  details:last-child {
    border-bottom: 0;
  }
  summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 20px;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: '+';
    color: var(--muted);
    font-size: 1.4rem;
    line-height: 1;
    font-weight: 300;
  }
  details[open] summary::after {
    content: '−';
  }
  summary h3 {
    font-size: 1.08rem;
  }
  summary:hover h3 {
    color: #fff;
  }
  details p {
    color: var(--muted);
    padding-bottom: 22px;
    max-width: 65ch;
  }

  /* Footer */
  .site-footer {
    border-top: 1px solid var(--line);
    font-size: 0.875rem;
    color: var(--muted);
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    padding-block: 24px;
  }
