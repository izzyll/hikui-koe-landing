---
// Página 404: no indexable, enlaza a ambas versiones del sitio.
import { withBase } from '../i18n/content';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>404 — Hikui Koe</title>
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <style>
      body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: #111217; color: #eceef4; font-family: 'Segoe UI', system-ui, sans-serif; padding: 16px; text-align: center; }
      a { color: #6c8cff; }
      h1 { font-size: 2rem; margin: 0 0 12px; }
    </style>
  </head>
  <body>
    <main>
      <h1>404</h1>
      <p>Página no encontrada · Page not found</p>
      <p><a href={withBase("/")}>Inicio</a> · <a href={withBase("/en/")}>Home</a></p>
    </main>
  </body>
</html>
